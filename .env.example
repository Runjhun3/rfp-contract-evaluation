# Copy to .env and fill in. Never commit .env. Never paste values in chat/tickets.

# --- AWS ---
AWS_REGION=ap-south-1
S3_BUCKET=rfp-contract-bucke
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Bedrock (Claude) ---
AWS_BEARER_TOKEN_BEDROCK=
# global.* = global cross-region inference (may process outside India) - see docs/security.md
CLAUDE_MODEL=global.anthropic.claude-sonnet-4-6

# --- Database ---
# Host values for `python run.py`. docker-compose.yml overrides DB_HOST inside containers.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rfp_eval
DB_USER=rfp
DB_PASSWORD=

# --- Web UI ---
SESSION_SECRET=              # optional; a random key is made at start if empty
COOKIE_SECURE=false          # true when served over HTTPS (the VM)
FILE_STORE=local             # s3 on the server
LOCAL_FILE_DIR=data/files
RUNS_DIR=runs

# --- Pipeline ---
LLM_MODE=bedrock            # bedrock | replay (cached answers only, no AWS)
LLM_CACHE_DIR=runs/_llm_cache
OCR_ENGINE=textract         # textract | tesseract (local, no AWS)
OCR_MIN_CHARS=50
OCR_MIN_IMAGE_RATIO=0.25
WORKER_CONCURRENCY=2
REVIEW_CONFIDENCE=0.80
